{
  "name": "@mileszko-landing-page/api",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./dist/api.types.ts",
    "./api.json": "./dist/api.json"
  },
  "scripts": {
    "build": "pnpm build:contact-message-handler && pnpm build:contact-message-delivered-email-handler && pnpm build:contact-message-notification-email-handler && pnpm build:templates && pnpm build:api-definition",
    "build:contact-message-handler": "esbuild src/handlers/contactMessageHandler.ts --bundle --platform=node --target=node26 --format=cjs --outfile=dist/contactMessageHandler/index.js --minify",
    "build:contact-message-delivered-email-handler": "esbuild src/handlers/contactMessageDeliveredEmailHandler.ts --bundle --platform=node --target=node26 --format=cjs --outfile=dist/contactMessageDeliveredEmailHandler/index.js --minify",
    "build:contact-message-notification-email-handler": "esbuild src/handlers/contactMessageNotificationEmailHandler.ts --bundle --platform=node --target=node26 --format=cjs --outfile=dist/contactMessageNotificationEmailHandler/index.js --minify",
    "build:templates": "node maizzle.js",
    "build:api-definition": "tsx src/generateApiDefinition.ts"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-dynamodb": "^3.1177.0",
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/client-sesv2": "^3.1177.0",
    "@aws-sdk/client-sns": "^3.1177.0",
    "@aws-sdk/lib-dynamodb": "^3.1177.0",
    "@maizzle/framework": "^5.2.2",
    "@mjackson/multipart-parser": "^0.10.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/libmime": "^5.3.0",
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "libmime": "^5.6.5",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-preset-email": "^1.4.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
