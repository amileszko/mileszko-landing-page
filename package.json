{
  "name": "@mileszko-landing-page/monorepo",
  "private": true,
  "packageManager": "pnpm@12.24.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "website:start": "turbo run start --filter=@mileszko-landing-page/website",
    "website:build": "turbo run build --filter=@mileszko-landing-page/website",
    "website:preview": "turbo run preview --filter=@mileszko-landing-page/website",
    "api:types": "turbo run build:api-definition --filter=@mileszko-landing-page/api",
    "api:build": "turbo run build --filter=@mileszko-landing-page/api",
    "cdk:synth": "turbo run synth --filter=@mileszko-landing-page/cdk",
    "cdk:deploy": "turbo run deploy --filter=@mileszko-landing-page/cdk",
    "check-types": "pnpm api:types && pnpm check-types:ts6 && pnpm check-types:ts7",
    "check-types:fast": "pnpm api:types && pnpm check-types:ts7",
    "check-types:ts6": "tsc6 --noEmit -p tsconfig.json && tsc6 --noEmit -p cdk/tsconfig.json && tsc6 --noEmit -p website/tsconfig.json && tsc6 --noEmit -p api/tsconfig.json",
    "check-types:ts7": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p cdk/tsconfig.json && tsc --noEmit -p website/tsconfig.json && tsc --noEmit -p api/tsconfig.json",
    "lint": "pnpm api:types && eslint",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check:build-size": "pnpm --filter @mileszko-landing-page/website check-build-size",
    "check:delivery": "node scripts/check-delivery.mjs",
    "test": "vitest run",
    "test:coverage:all": "vitest run --coverage --config vitest.coverage-all.config.ts",
    "test:coverage:core": "vitest run --coverage",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^26.6.10",
    "@typescript-eslint/parser": "^8.74.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/old": "npm:typescript@^6.0.3",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-newlines": "^2.1.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "turbo": "^2.11.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
